---
import Header from "./Header/index.astro";
import LocaleSwitcher from "../components/i18n/LocaleSwitcher.astro";

interface Props {
  title: string;
}

const currentLocale = Astro.currentLocale;
const { title } = Astro.props;
---

<!doctype html>
<html class="scroll-smooth font-body" lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/resume/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;700&family=Titillium+Web:wght@200;400;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <script
      data-goatcounter="https://tomas-benitez.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
    <title>{title}</title>
  </head>
  <body class="text-zinc-100">
    <div class="lottie-animation fixed inset-0 -z-10 opacity-50"></div>
    <Header />
    <div class="relative snap-start snap-always">
      <img
        src="/resume/code-image-start-2.jpg"
        alt="Javascript code on a screen"
      />
    </div>
    <main class="snap-start snap-always pb-12">
      <slot />
    </main>
    <LocaleSwitcher />
  </body>
</html>

<style>
  :root {
    --header-height: 5rem;
    --body-bg: #003a5f;
  }

  html {
    scroll-padding-top: var(--header-height);
  }

  body {
    background-color: var(--body-bg);
  }

  img {
    width: 100%;
    height: calc(var(--header-height) + 20rem);
    object-fit: cover;
    object-position: bottom center;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0) 100%
    );
  }
</style>

<script>
  import lottie from "lottie-web";

  const loadLottieBg = () => {
    const container = document.querySelector(".lottie-animation");
    if (!container) {
      console.error("Lottie container not found");
      return;
    }

    const animationItem = lottie.loadAnimation({
      container,
      renderer: "svg",
      loop: true,
      autoplay: true,
      path: "/resume/styles/lottie-bg.json",
      rendererSettings: {
        preserveAspectRatio: "xMidYMid slice",
      },
    });

    animationItem.setSpeed(0.2);
  };
  document.addEventListener("DOMContentLoaded", loadLottieBg);
</script>
